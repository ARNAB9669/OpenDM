{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/frontend/login.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/frontend/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/frontend/app/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/public/$1"
    }
  ]
}
